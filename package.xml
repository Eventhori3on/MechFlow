  <tag>solidworks</tag>
  <tag>workflow</tag>
  <tag>user interface</tag>
  <tag>part design</tag>
  <tag>assembly</tag>
  <tag>drawing</tag>

  <content>
    <workbench>
      <name>MechFlow</name>
      <classname>MechFlowWorkbench</classname>
      <subdirectory>./</subdirectory>
      <icon>Resources/icons/MechFlow.svg</icon>
